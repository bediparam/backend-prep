<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ecommerce</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-300">

    <div class="max-w-5xl bg-neutral-200 p-4 my-32 h-[100%] mx-auto mt-12 rounded-xl">

        <h1 class="font-bold text-xl">Products</h1>

        <div class="bg-neutral-50 mx-auto my-12 p-2 border rounded-xl grid grid-cols-2">
            <% if (products.length > 0) {%>
            <% products.forEach( (product) => { %>
                <div class="m-2 border-2 rounded-xl p-2 flex flex-col gap-4 relative"> 
                    
                    <h1 class="font-bold"><%= product.name %> </h1>
                    <img class="w-20 h-20" src="<%=product.imageUrl%>" alt="<%=product.name%>">
                    <p>Description: <%=product.description%></p>
                    <p>Price: Rs <%=product.price%></p>

                    <div class="flex gap-2 absolute bottom-1 right-1">
                        <a href="/products/edit/<%=product._id%>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen preview-icon"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
                        </a>
                        <a href="/">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash preview-icon"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </a>
                    </div>
                
                </div>
                
            <% }) %>
            <% } else {%>
                <h1 class="font-bold text-xl">No Products Available</h1>
            <% }%>
        </div>
    </div>

    <div class="max-w-3xl p-4 fixed left-1 bottom-1">
        <form action="/products" method="post" class="flex flex-col gap-2">
            <input class="max-w-xl p-2 border rounded-lg" type="text" name="name" placeholder="Name of product...">
            <input class="max-w-xl p-2 border rounded-lg" type="text" name="description" placeholder="Description of the product..." >
            <input class="max-w-xl p-2 border rounded-lg" type="number" name="price" placeholder="Price Amount...">
            <input class="max-w-xl p-2 border rounded-lg" type="text" name="imageUrl" placeholder="Enter Image Url">
            <button class="max-w-xl p-2 border rounded-lg" type="submit">
                Add Product
            </button>
        </form>
    </div>

  </body>
</html>