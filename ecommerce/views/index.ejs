<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ecommerce</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-300">

    <div class="max-w-5xl bg-neutral-200 p-4 my-32 h-[100%] mx-auto mt-12 rounded-xl">

        <h1 class="font-bold text-xl">Products</h1>

        <div class="bg-neutral-50 mx-auto my-12 p-2 border rounded-xl">
            <% if (products.length > 0) {%>
            <% products.forEach( (product) => { %>
                <div class="m-2 border-2 rounded-xl p-2 flex gap-4"> 
                    
                    <h1><%= product.name %> </h1>
                
                </div>
                
            <% }) %>
            <% } else {%>
                <h1 class="font-bold text-xl">No Products Available</h1>
            <% }%>
        </div>
    </div>

  </body>
</html>