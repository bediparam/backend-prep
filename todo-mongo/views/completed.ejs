<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Todo mongodb</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-300">
    <div class="mt-4 max-w-5xl mx-auto flex justify-between items-center">
        <a href="/todo" class="font-bold text-xl">TO DO LIST</a>
        <a href="/todo" class="text-sm border border-neutral-200 p-2 rounded">Upcoming Tasks</a>

    </div>

    <div class="max-w-3xl bg-neutral-200 p-4 my-32 h-[100%] mx-auto mt-12 rounded-xl">

        <h1 class="font-bold text-xl">Completed Tasks</h1>

        <div class="bg-neutral-50 mx-auto my-12 p-2 border rounded-xl">
            <% if (todos.length >0) {%>
            <% todos.forEach( (todo) => { %>
                <div class="m-2 border-2 rounded-xl p-2 flex justify-between"> 
                    <h1><%= todo.title %> </h1>
                    <form action="/todo/<%= todo.id%>/delete" method="post">
                        <button type="submit">Delete</button>
                    </form>
                </div> 
            <% }) %>
            <% } else {%>
                <h1 class="font-bold text-xl">No completed tasks</h1>
            <% }%>

            
        </div>
    </div>
     
  </body>
</html>
