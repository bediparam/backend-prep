<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Todo mongodb</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-300">
    <div class="mt-4 max-w-5xl mx-auto flex justify-between items-center">
        <a href="/" class="font-bold text-xl">TO DO LIST</a>
        <a href="/completed" class="text-sm border border-neutral-200 p-2 rounded">Completed Tasks</a>

    </div>

    <div class="max-w-3xl bg-neutral-200 p-4 my-32 h-[100%] mx-auto mt-12 rounded-xl">

        <h1 class="font-bold text-xl">Upcoming Tasks</h1>

        <div class="bg-neutral-50 mx-auto my-12 p-2 border rounded-xl">
            <% if (todos.length >0) {%>
            <% todos.forEach( (todo) => { %>
                <div class="m-2 border-2 rounded-xl p-2 flex gap-4"> 
                    
                    <form action="/todo/<%= todo.id %>/complete" method="post" class="">
                        <button type="submit" class="w-4 h-4 border border-neutral-400 rounded-full cursor-pointer"></button>
                    </form>
                    <h1><%= todo.title %> </h1>
                
                </div>
                
            <% }) %>
            <% } else {%>
                <h1 class="font-bold text-xl">No upcoming tasks</h1>
            <% }%>
        </div>
    </div>
    <div class="w-full mx-auto fixed bottom-5">
        <form action="/todo" method="post" class="max-w-xl mx-auto flex relative">
            <input 
                type="text" 
                name="title" 
                class="w-full py-4 px-6 border rounded-3xl border-neutral-200 focus:ring-4 focus:ring-orange-200 focus:outline-none" 
                placeholder="Enter your title" />
            <button 
                type="submit"
                class="absolute h-10 w-10 right-1 flex justify-center items-center bg-orange-600 text-white rounded-full mt-2 mr-2 cursor-pointer"
                > + 
            </button>
        </form>
    </div>
  </body>
</html>
